(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language turn on the stove and put the moka pot on it)
    (:regions
      (occ0_region
          (:target kitchen_table)
          (:ranges (
              (0.1150 -0.1200 0.1450 -0.0900)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (occ1_region
          (:target kitchen_table)
          (:ranges (
              (0.1150 -0.0500 0.1450 -0.0200)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (occ2_region
          (:target kitchen_table)
          (:ranges (
              (0.1150 0.0200 0.1450 0.0500)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (occ3_region
          (:target kitchen_table)
          (:ranges (
              (0.1150 0.0900 0.1450 0.1200)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 0.19 -0.19 0.21000000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.07500000000000001 -0.275 -0.025 -0.225)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 -0.025 0.07500000000000001 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    milk_9 - milk
    orange_juice_9 - orange_juice
    ketchup_9 - ketchup
    bbq_sauce_9 - bbq_sauce
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
  )

  (:obj_of_interest
    moka_pot_1
    flat_stove_1
  )

  (:init
    (On milk_9 kitchen_table_occ0_region)
    (On orange_juice_9 kitchen_table_occ1_region)
    (On ketchup_9 kitchen_table_occ2_region)
    (On bbq_sauce_9 kitchen_table_occ3_region)
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On chefmate_8_frypan_1 kitchen_table_frypan_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
  )

  (:goal
    (And (Turnon flat_stove_1) (On moka_pot_1 flat_stove_1_cook_region))
  )

)
