            )
          )
      )
      (occ3_region
          (:target living_room_table)
          (:ranges (
              (0.0150 0.1200 0.0450 0.1500)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_left_region
