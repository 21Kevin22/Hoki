     def _inside(self, spheres, pad):
         g = self.map.grid
         d = np.linalg.norm(g.centres[:, None] - spheres.centres[None], axis=2) - spheres.radii[None] - pad
         return (d.min(1) < 0).reshape(g.shape)
+
+
+def permission_voxels(g, P, F=None, dilation=0):
+    """Voxels a robot part may touch: those of the allowed points P grown by `dilation` voxels. v5: the growth never
+    covers a voxel of the forbidden points F (a neighbouring wall stays an obstacle); P's own voxels always stay."""
+    from scipy.ndimage import binary_dilation
+    def vox(Q):
+        m = np.zeros(g.shape, bool)
+        if Q is not None and len(Q):
+            Q = Q[g.contains(Q)]
+            m.reshape(-1)[np.unique(g.flat_index(Q))] = True
+        return m
+    m = vox(P)
+    if m.any() and dilation:
+        grown = binary_dilation(m, iterations=dilation)
+        m = m | (grown & ~vox(F)) if F is not None else grown
+    return m
