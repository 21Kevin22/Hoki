+    def _visibility_fields(self, held, held_clear_pad, robot):
+        """v5: unseen voxels a camera could have seen or that hide behind a real surface (the AUTO selection), minus
+        the table, the robot and the held object, as a second obstacle set with margin m0 + Delta (safety_filter).
+        The hand ignores them inside the task container's interior boxes (it must reach in before seeing all)."""
+        self.unknown_arm_field = self.unknown_hand_field = None
+        if self.safety_cfg.visibility_margin_m <= 0:
+            return
+        m, g, sm = self.map, self.map.grid, self.safety_cfg.gradient_smoothing_vox
+        sel = m.shadow if self.safety_cfg.visibility_unknown == "shadow" else (m.shadow | (m.in_view & ~m.robot_shadow))
+        U = m.unknown & sel & ~m.table_surface() & ~self._inside(robot, 0.0)
+        if held is not None:
+            U &= ~self._inside(held, held_clear_pad)
+        if not U.any():
+            return
+        inside = np.zeros(g.shape, bool)
+        for lo, hi in self.interior_boxes:
+            c = g.centres
+            inside |= np.all((c >= np.asarray(lo)) & (c <= np.asarray(hi)), axis=1).reshape(g.shape)
+        self.unknown_arm_field = DistanceField.from_obstacles(g, U, sm)
+        Uh = U & ~inside
+        self.unknown_hand_field = DistanceField.from_obstacles(g, Uh, sm) if Uh.any() else None
+
+    def _unseen_shadow(self, held, held_clear_pad, robot):
+        """v5b: unseen voxels hidden behind a real surface, minus table, robot and held object (as _visibility_fields)."""
+        m = self.map
+        U = m.unknown & m.shadow & ~m.table_surface() & ~self._inside(robot, 0.0)
+        if held is not None:
+            U &= ~self._inside(held, held_clear_pad)
+        return U
