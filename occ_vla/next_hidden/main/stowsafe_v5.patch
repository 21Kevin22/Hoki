diff -ruN -x __pycache__ -x .pytest_cache -x results -x '*.pyc' stowsafe_kit_v4/stowsafe/tests/test_v5_visibility.py stowsafe_kit_v5/stowsafe/tests/test_v5_visibility.py
--- stowsafe_kit_v4/stowsafe/tests/test_v5_visibility.py	1970-01-01 00:00:00.000000000 +0000
+++ stowsafe_kit_v5/stowsafe/tests/test_v5_visibility.py	2026-11-22 03:05:18.729007549 +0000
@@ -0,0 +1,99 @@
+"""v5 (next_hidden PREREG_main.md §3): visibility-dependent margin and the separate held-object field."""
+import numpy as np
+from stowsafe.config import SafetyConfig
+from stowsafe.safety_filter import WholeBodySafetyFilter, _margins
+from stowsafe.spheres import SpheresInWorld, SphereGroup
+from stowsafe.voxel_map import VoxelGrid, DistanceField
+
+
+def _filter(**kw):
+    f = WholeBodySafetyFilter.__new__(WholeBodySafetyFilter)
+    f.cfg = SafetyConfig(**kw)
+    return f
+
+
+GRID = VoxelGrid(np.zeros(3), np.ones(3) * 0.4, 0.02)
+
+
+def _field(*voxels):
+    occ = np.zeros(GRID.shape, bool)
+    for v in voxels:
+        occ[v] = True
+    return DistanceField.from_obstacles(GRID, occ)
+
+
+def _spheres(points, groups):
+    P = np.asarray(points, float)
+    return SpheresInWorld(P, np.full(len(P), 0.01), np.zeros(len(P), int), tuple(groups), tuple(map(str, range(len(P)))))
+
+
+FAR = _field()                                   # no observed obstacle anywhere
+UNSEEN = _field((10, 10, 10))                    # one unseen voxel at the centre (0.21 m)
+
+
+def test_delta_zero_ignores_unseen_space():
+    S = _spheres([[0.21, 0.21, 0.30]], [SphereGroup.ARM])
+    C0, _ = _filter()._clearances(S, FAR, FAR, False, unknown_arm_field=UNSEEN)
+    assert C0[0] > 0.5                              # Delta = 0 (v4 behaviour): unseen voxels do not constrain
+
+
+def test_delta_shrinks_clearance_to_unseen_space_by_exactly_delta():
+    S = _spheres([[0.21, 0.21, 0.30]], [SphereGroup.ARM])
+    D, _ = UNSEEN.query(S.centres)
+    expect = D[0] - 0.01 - _margins(SafetyConfig(), S.groups)[0] - 0.03
+    C, G = _filter(visibility_margin_m=0.03)._clearances(S, FAR, FAR, False, unknown_arm_field=UNSEEN)
+    assert abs(C[0] - expect) < 1e-6 and G[0][2] > 0      # pushed away (+z) from the unseen voxel
+
+
+def test_hand_uses_its_own_unknown_field_inside_the_interior():
+    S = _spheres([[0.21, 0.21, 0.30], [0.21, 0.21, 0.30]], [SphereGroup.ARM, SphereGroup.PALM])
+    # the hand field is None when every unseen voxel lies inside the container interior: hand unconstrained
+    C, _ = _filter(visibility_margin_m=0.03)._clearances(S, FAR, FAR, False, unknown_arm_field=UNSEEN,
+                                                          unknown_hand_field=None)
+    assert C[0] < 0.2 and C[1] > 0.5
+
+
+def test_closing_fingers_stay_free_of_the_unseen_margin():
+    S = _spheres([[0.21, 0.21, 0.30]], [SphereGroup.FINGER])
+    C, _ = _filter(visibility_margin_m=0.03)._clearances(S, FAR, FAR, True, unknown_hand_field=UNSEEN)
+    assert C[0] > 0.5
+
+
+def test_held_object_uses_its_own_field():
+    S = _spheres([[0.21, 0.21, 0.30], [0.21, 0.21, 0.30]], [SphereGroup.ARM, SphereGroup.HELD])
+    arm = _field((10, 10, 12))                       # obstacle 2 cm under the sphere for the arm
+    C, _ = _filter()._clearances(S, FAR, FAR, False, arm_field=arm, held_field=FAR)
+    assert C[0] < 0.05 and C[1] > 0.5               # the held object may approach what the arm may not
