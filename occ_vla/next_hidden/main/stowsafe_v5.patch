+def test_slow_surface_caps_approach_speed_but_allows_contact():
+    f = _filter(slow_speed_m=0.001, gamma=0.5)
+    S = _spheres([[0.21, 0.21, 0.244]], [SphereGroup.PALM])          # 1.4 cm above a slow voxel, radius 1 cm
+    calls = {}
+    f._constraints = lambda data, sp, c, g, idx: (calls.setdefault("g", g[idx]) is not None and np.array([[0, 0, 1.0, 0, 0, 0]]), None)
+    idx, G, b = f._slow(None, S, dict(palm=UNSEEN), closing=False)
+    D, _ = UNSEEN.query(S.centres)
+    h = D[0] - 0.01
+    assert list(idx) == [0] and abs(b[0] + (0.5 * h + 0.001)) < 1e-9        # no margin: touching is allowed
+    assert calls["g"][0][2] > 0                                              # gradient points away from the surface
+    far = _spheres([[0.21, 0.21, 0.35]], [SphereGroup.PALM])
+    assert len(f._slow(None, far, dict(palm=UNSEEN), closing=False)[0]) == 0  # beyond slow_range_m: no row
