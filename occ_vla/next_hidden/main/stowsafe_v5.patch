+def test_permission_growth_does_not_leak_onto_a_forbidden_wall():
+    from stowsafe.perception import permission_voxels
+    c = lambda v: GRID.centres.reshape(*GRID.shape, 3)[v]
+    handle, wall = c((10, 10, 10)), c((11, 10, 10))
+    old = permission_voxels(GRID, handle[None], None, 1)
+    new = permission_voxels(GRID, handle[None], wall[None], 1)
+    assert old[11, 10, 10] and not new[11, 10, 10]          # v4 growth covered the wall; v5 keeps it an obstacle
+    assert new[10, 10, 10] and new[9, 10, 10] and new.sum() == old.sum() - 1
+    both = permission_voxels(GRID, np.stack([handle, wall]), wall[None], 1)
+    assert both[11, 10, 10]                                  # an explicitly allowed point is never removed
