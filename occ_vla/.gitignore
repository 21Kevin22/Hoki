# --- OpenVLA-OFT vjepa_predictor investigation (thirdparty/openvla-oft/) ---
# Local-only notes for the pi0.5/MMaDA investigation, not meant for this repo.
# Anchored to the occ_vla root only -- thirdparty/openvla-oft/CLAUDE.md is a
# separate, intentionally-committed file for the OpenVLA-OFT investigation.
/CLAUDE.md

# Stray binary (not project source) sitting at the occ_vla root — flagged for
# the user to inspect/remove, never intended for commit either way.
/claude

# Downloaded base-model checkpoints (each ~15GB, one per LIBERO suite) —
# reproducible via huggingface_hub.snapshot_download, not versioned here.
checkpoints/

# Vendored LIBERO source checkout, reproducible via setup.
.libero_oft_src/

# Vendored reference repos not imported by any of our scripts.
thirdparty/ManiCM/
thirdparty/vjepa2/

# Collected on-policy rollout / failure-probe training data — large,
# reproducible via scripts/collect_oft_onpolicy_rollout_data.py /
# scripts/collect_failure_probe_data.py.
thirdparty/openvla-oft/oft_onpolicy_rollout_data*/
thirdparty/openvla-oft/failure_probe_data*/
thirdparty/openvla-oft/vjepa_error_diagnosis_raw.json
thirdparty/openvla-oft/vjepa_error_diagnosis_*.png
thirdparty/openvla-oft/vjepa_error_diagnosis_*.npy

# Intermediate (mid-training) predictor checkpoints — only the final
# vjepa_predictor_*.pt files are kept, not the periodic .stepNNNN snapshots.
thirdparty/openvla-oft/*.pt.step*
thirdparty/openvla-oft/*.pt.back.*
thirdparty/openvla-oft/**/*.back.*

.venv_dev_test/

# Vendored LIBERO + LIBERO-Occ checkouts used by the occluded-suite scripts
# (LIBERO pinned to Lifelong-Robot-Learning/LIBERO@8f1084e, Libero-Occ pinned
# to litsh/Libero-Occ@25cc040) — reproducible via scripts/setup_libero_occ_env.sh,
# not versioned here (643MB / 5.6MB, external repos not this project's own code).
thirdparty/LIBERO/
thirdparty/Libero-Occ/

# Per-run experiment output directories (run_libero_occluded_oracle_headroom.py
# --results-dir) — reproducible by rerunning the documented command, not meant
# to be diffed/frozen. Named ad hoc per experiment (task ids, condition names,
# episode counts) rather than one fixed pattern, so this is illustrative, not
# exhaustive — check `git status` before committing a new results-dir by habit.
thirdparty/openvla-oft/*_n[0-9]*/
thirdparty/openvla-oft/exp*_task*/
thirdparty/openvla-oft/smoke_*/
thirdparty/openvla-oft/replicate_task*/
thirdparty/openvla-oft/blank_libero10_*/

# occ_vla additions (2026-09-06): the actual checkpoint/tokenizer files that
# every eval script loads live under checkpoints/, not here — these are
# stray/duplicate copies plus per-run experiment output that accumulated
# directly under scripts/ (an older convention, separate from the
# thirdparty/openvla-oft/*_n[0-9]*/ pattern above which covers newer runs).
# Large binaries: transfer out-of-band, never commit.
scripts/*.safetensors
scripts/*_checkpoint.pt
scripts/object_centric_adapter_weights.pt
scripts/lora_adapter/
scripts/step[0-9]*/
scripts/config.json.back.*
scripts/*.py.back.*
scripts/object_centric_adapter_task*/
scripts/month2_collect_task*/
scripts/rollout_task2_*/
scripts/video_task2_*/
scripts/video_*_physical*/
scripts/paired_task2_*/
scripts/probe_task2_*/
scripts/factorial_*_n[0-9]*/
scripts/contact_survey_*_remaining/

# occ_vla additions (2026-09-06): stray checkpoint-directory copies. HF's
# trust_remote_code loading sometimes copies the model's own source/config
# files alongside the checkpoint weights it loads from -- these are stale
# duplicates of files that are properly tracked under
# thirdparty/openvla-oft/prismatic/extern/hf/ and checkpoints/, not a second
# source of truth (confirmed 2026-09-06: the scripts/ copy of
# modeling_prismatic.py predates the ControlVLA-redesign edit and does not
# contain it).
